{
  "id": "ORDER-002",
  "title": "手机号格式错误时给出可读提示",
  "requirement": "REQ-ORDER-VALIDATION",
  "priority": "P1",
  "tags": ["negative", "order"],
  "risk": "非法输入被静默吞掉，用户不知道发生了什么",
  "steps": [
    { "action": "goto", "url": "/demo/login.html" },
    { "action": "fill", "target": { "label": "手机号", "exact": true }, "value": "123" },
    { "action": "click", "target": { "testid": "query-submit" } },
    { "action": "expect", "target": { "role": "alert" }, "assertion": { "type": "text", "value": "手机号格式不正确" } },
    { "action": "expect", "target": { "role": "alert" }, "assertion": { "type": "visible" } }
  ]
}
